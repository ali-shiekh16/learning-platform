# Production settings for compose.prod.yml. Copy to .env next to compose.prod.yml,
# fill in, and `chmod 600 .env`. Never commit the real file.

# Public hostname (no https://). DNS must point at this server before the first start.
APP_DOMAIN=learn.example.com

# Database password. Use letters and digits only (it goes into a URL):
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Signs session cookies. Generate a new one for production:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# LiveKit Cloud project (https://cloud.livekit.io → Settings → Keys)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
