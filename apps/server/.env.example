# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
PORT=3000

# Postgres started by `npm run db:up` (docker-compose.yml)
DATABASE_URL=postgresql://app:app@localhost:5433/learning

# better-auth: secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-with-a-long-random-string
# The public origin users open in the browser (the Vite dev server in development)
BETTER_AUTH_URL=http://localhost:5173

# LiveKit Cloud project (https://cloud.livekit.io → Settings → Keys)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Behind a hosting proxy (Render, Railway, ...) set to true so rate limits and session
# records see the visitor's IP instead of the proxy's. Leave unset for local development.
# TRUST_PROXY=true
