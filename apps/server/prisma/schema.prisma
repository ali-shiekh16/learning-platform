generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Authentication (tables required by better-auth) ────────────────

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("STUDENT") // "STUDENT" | "TEACHER"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  meetingsTaught      Meeting[]
  meetingParticipants MeetingParticipant[]
  chatMessages        ChatMessage[]
  sudokuGames         SudokuGame[]

  @@map("users")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model Meeting {
  id           String               @id @default(cuid())
  title        String
  joinCode     String               @unique
  status       String               @default("LIVE") // "LIVE" | "ENDED"
  teacherId    String
  teacher      User                 @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt    DateTime             @default(now())
  endedAt      DateTime?
  participants MeetingParticipant[]
  messages     ChatMessage[]
  whiteboard   Whiteboard?

  @@index([status])
  @@index([teacherId])
  @@map("meetings")
}

// Attendance: one row per user per meeting. `removed` blocks rejoining.
model MeetingParticipant {
  id        String    @id @default(cuid())
  meetingId String
  meeting   Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  removed   Boolean   @default(false)

  @@unique([meetingId, userId])
  @@index([userId])
  @@map("meeting_participants")
}

model ChatMessage {
  id        String   @id @default(cuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([meetingId, createdAt])
  @@map("chat_messages")
}

// One board per meeting.
model Whiteboard {
  meetingId String   @id
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  elements  Json     @default("[]")
  locked    Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("whiteboards")
}

// ─── Sudoku (Module 4) ────────────────────

// One timed game. A finished game is also its report: the counts and score are written
// once when it ends, so a separate reports table would only duplicate them.
// Grids are 81 characters, row by row, "0" for empty. `solution` never leaves the server.
// At most one IN_PROGRESS game per user: a partial unique index added in the migration SQL
// (Prisma's schema language can't express partial indexes).
model SudokuGame {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  difficulty   String // "EASY" | "MEDIUM" | "HARD"
  puzzle       String       @db.Char(81)
  solution     String       @db.Char(81)
  board        String       @db.Char(81)
  timeLimitS   Int
  status       String       @default("IN_PROGRESS") // "IN_PROGRESS" | "COMPLETED" | "TIMED_OUT" | "FAILED" | "ABANDONED"
  correctCount Int          @default(0)
  mistakes     Int          @default(0)
  score        Int?
  startedAt    DateTime     @default(now())
  endedAt      DateTime?
  moves        SudokuMove[]

  @@index([userId, endedAt])
  @@map("sudoku_games")
}

// Every value placed, in order: the audit trail and a way to replay a game.
model SudokuMove {
  id        String     @id @default(cuid())
  gameId    String
  game      SudokuGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  row       Int
  col       Int
  value     Int // 1-9, or 0 for clearing a wrong entry
  isCorrect Boolean
  createdAt DateTime   @default(now())

  @@index([gameId, createdAt])
  @@map("sudoku_moves")
}
